# Copy this file to .env and replace every placeholder that applies.
# Never commit .env or real credentials.

# Local SQLite database
DATABASE_URL="file:./prisma/dev.db"

# Auth.js / NextAuth. Generate a unique value, for example: openssl rand -base64 32
AUTH_SECRET="<replace-with-a-random-secret>"
NEXTAUTH_URL="http://localhost:3000"

# Required by `npm run db:seed`. ADMIN_PASSWORD must be at least 12 characters.
ADMIN_NAME="<replace-with-admin-display-name>"
ADMIN_EMAIL="<replace-with-admin-email>"
ADMIN_PASSWORD="<replace-with-a-strong-unique-password>"

# Brevo SMTP email notifications
BREVO_SMTP_USER="<replace-with-brevo-smtp-user>"
BREVO_SMTP_KEY="<replace-with-brevo-smtp-key>"
EMAIL_FROM="<replace-with-verified-sender>"

# Fine per overdue day, in currency units
FINE_PER_DAY="5"

# WhatsApp delivery is currently disabled in the application.
# These placeholders are reserved for enabling it in a future implementation.
WHATSAPP_PHONE_NUMBER_ID="<replace-when-whatsapp-is-enabled>"
WHATSAPP_ACCESS_TOKEN="<replace-when-whatsapp-is-enabled>"
